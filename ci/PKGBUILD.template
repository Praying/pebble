# Maintainer: Pebble contributors
# This file is generated from the Pebble repository's CI template.

pkgname=pebble-bin
_tag=@TAG@
pkgver=$(echo $_tag | tr - .)
pkgrel=2
pkgdesc='A GPU-accelerated Linux terminal emulator and multiplexer'
arch=('i686' 'x86_64')
url='https://github.com/Praying/pebble'
license=('MIT')
provides=('pebble')
conflicts=('pebble')
# Don't strip: it will break the binary and it only saves ~10% anyway
options=('!strip')
makedepends=('fuse')
depends=(
  'dbus'
  'fontconfig'
  'hicolor-icon-theme'
  'libx11'
  'libxkbcommon-x11'
  'wayland'
  'xcb-util-keysyms'
  'xcb-util-wm'
)
optdepends=(
  'python-nautilus: Pebble context menu in Nautilus'
)
source=(
  "pebble::https://github.com/Praying/pebble/releases/download/${_tag}/Pebble-${_tag}-Ubuntu16.04.AppImage"
  'LICENSE::https://github.com/Praying/pebble/raw/main/LICENSE.md'
)
sha256sums=(
  '@SHA256@'
  'ad915d9508677a4e94e4b3c0a045fedd20e953d95d7cd3ec97e6d16840fa0ed5'
)

prepare() {
  chmod +x "${srcdir}/pebble"
}

pkgver() {
  "${srcdir}/pebble" --version | cut -d' ' -f2 | tr - .
}

build() {
  "${srcdir}/pebble" --appimage-extract >/dev/null
}

package() {
  install -Dm755 squashfs-root/usr/bin/pebble -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/pebble-gui -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/pebble-mux-server -t "${pkgdir}/usr/bin/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/128x128/apps/io.github.praying.pebble.png \
                 "${pkgdir}/usr/share/icons/hicolor/128x128/apps/io.github.praying.pebble.png"
  install -Dm644 squashfs-root/usr/share/applications/io.github.praying.pebble.desktop \
                 "${pkgdir}/usr/share/applications/io.github.praying.pebble.desktop"
  install -Dm644 squashfs-root/usr/share/nautilus-python/extensions/pebble-nautilus.py \
                 "${pkgdir}/usr/share/nautilus-python/extensions/pebble-nautilus.py"
}
